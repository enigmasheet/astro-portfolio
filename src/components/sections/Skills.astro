---
import { SKILLS } from '../../data/skills';
---

<div class="grid sm:grid-cols-2 gap-x-10" data-reveal>
  {
    SKILLS.map((group) => (
      <section class="stack-group py-5 border-t border-border">
        <h3 class="font-mono text-xs font-medium tracking-wide uppercase text-primary mb-3">
          {group.category}
        </h3>
        <p class="text-sm md:text-base text-text-secondary leading-7">{group.skills.join(' · ')}</p>
      </section>
    ))
  }
</div>
