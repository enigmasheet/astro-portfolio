---
import { NAV_LINKS } from '../../data/navigation';
import { RESUME_PATH } from '../../data/social';
import ThemeToggle from './ThemeToggle.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const contactHref = base + '#contact';
---

<nav
  aria-label="Main navigation"
  class="fixed top-0 left-0 right-0 z-50 bg-bg/95 backdrop-blur-sm border-b border-border transition-colors duration-300"
  transition:name="navbar"
>
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a
      href={base}
      class="text-base font-semibold tracking-tight no-underline text-text"
      aria-label="Abhay Kumar Mandal home"
    >
      &lt;Abhay/&gt;
    </a>

    <div class="hidden md:flex items-center gap-1">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            data-astro-prefetch
            class="nav-link px-3 py-2 text-sm font-medium text-text-secondary hover:text-primary transition-colors no-underline"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={RESUME_PATH}
        class="ml-3 px-3 py-2 text-sm font-medium text-text-secondary hover:text-primary transition-colors no-underline"
        >Resume</a
      >
      <a
        href={contactHref}
        class="ml-1 px-3.5 py-2 text-sm font-medium border border-border-strong rounded-sm text-text hover:border-primary hover:text-primary transition-colors no-underline"
        >Contact</a
      >
      <span class="ml-2"><ThemeToggle /></span>
    </div>

    <div class="flex md:hidden items-center gap-2">
      <ThemeToggle />
      <button
        id="nav-toggle"
        class="w-11 h-11 flex items-center justify-center text-text-secondary hover:text-primary transition-colors cursor-pointer"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>
</nav>

<div
  id="drawer-backdrop"
  class="fixed inset-0 z-30 bg-black/30 md:hidden invisible opacity-0 transition-[opacity,visibility] duration-200 ease-in-out"
  aria-hidden="true"
>
</div>
<div
  id="mobile-drawer"
  class="fixed top-16 left-0 right-0 z-40 bg-surface border-b border-border md:hidden invisible opacity-0 -translate-y-2 transition-[opacity,transform,visibility] duration-200 ease-in-out"
  aria-label="Mobile navigation"
>
  <div class="px-4 py-3 flex flex-col">
    {
      NAV_LINKS.map((link) => (
        <a
          href={link.href}
          data-astro-prefetch
          class="nav-link min-h-12 flex items-center px-2 text-sm font-medium text-text-secondary hover:text-primary transition-colors no-underline border-b border-border"
        >
          {link.label}
        </a>
      ))
    }
    <div class="flex gap-3 pt-4">
      <a href={RESUME_PATH} class="button-link">Resume</a>
      <a href={contactHref} class="button-link button-link-primary">Contact</a>
    </div>
  </div>
</div>

<style>
  .button-link {
    min-height: 44px;
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 0.2rem;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .button-link-primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--text-on-accent);
  }
</style>

<script>
  import '../../scripts/navbar';
</script>
