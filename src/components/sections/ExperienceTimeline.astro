---
import type { Experience } from '../../types';

export interface Props {
  items: Experience[];
}

const { items } = Astro.props;

function formatDate(date: string): string {
  return new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

function formatRange(item: Experience): string {
  const start = formatDate(item.date);
  const end = item.endDate ? formatDate(item.endDate) : 'Present';
  return `${start} — ${end}`;
}
---

<ol class="experience-list">
  {
    items.map((item) => (
      <li class="experience-item" data-reveal>
        <p class="experience-date">{formatRange(item)}</p>
        <div class="experience-copy">
          <h3 class="experience-title">{item.title}</h3>
          <p class="experience-company">{item.company}</p>
          <p class="experience-description">{item.description}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .experience-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience-item {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.32fr) minmax(0, 1fr);
    gap: 1rem 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }

  .experience-date {
    margin: 0.2rem 0 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
  }

  .experience-title {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .experience-company {
    margin: 0.25rem 0 0;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .experience-description {
    max-width: 46rem;
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .experience-item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.4rem;
      padding: 1.2rem 0;
    }
  }
</style>
