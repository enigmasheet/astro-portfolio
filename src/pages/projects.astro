---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import { PROJECTS } from '../data/projects';
import { SECTIONS } from '../data/site';

const allTechnologies = [...new Set(PROJECTS.flatMap((p) => p.technologies))].sort();
---

<PageLayout title="Projects" description={SECTIONS.projects.description}>
  <section class="page-section">
    <div class="max-w-6xl mx-auto px-4">
      <SectionHeading
        as="h1"
        label={SECTIONS.projects.label}
        title={SECTIONS.projects.title}
        description={SECTIONS.projects.description}
        centered
      />

      <div class="project-controls mb-8" data-project-filters data-reveal>
        <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_15rem_auto]">
          <div class="relative">
            <label for="project-search" class="sr-only">Search projects</label>
            <span
              class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-text-secondary text-xl pointer-events-none"
              aria-hidden="true">search</span
            >
            <input
              id="project-search"
              type="search"
              placeholder="Search name, stack, or topic"
              autocomplete="off"
              class="w-full min-h-12 pl-10 pr-4 py-3 rounded-md border border-border bg-surface text-text focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
            />
          </div>

          <div>
            <label for="project-technology" class="sr-only">Filter projects by technology</label>
            <select
              id="project-technology"
              class="w-full min-h-12 px-3 py-3 rounded-md border border-border bg-surface text-text-secondary focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent cursor-pointer"
            >
              <option value="all">All technologies</option>
              {allTechnologies.map((tech) => <option value={tech.toLowerCase()}>{tech}</option>)}
            </select>
          </div>

          <button
            id="clear-project-filters"
            type="button"
            class="min-h-12 px-4 rounded-md text-sm font-medium text-primary hover:bg-primary/5 transition-colors cursor-pointer hidden"
          >
            Clear filters
          </button>
        </div>

        <p
          id="project-results"
          class="mt-3 text-sm text-text-secondary"
          role="status"
          aria-live="polite"
        >
          {PROJECTS.length} projects
        </p>
      </div>

      <div id="project-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          PROJECTS.map((p) => (
            <div
              class="project-item"
              data-technologies={p.technologies.map((tech) => tech.toLowerCase()).join('|')}
              data-search={`${p.title} ${p.description} ${p.technologies.join(' ')} ${p.tags.join(' ')}`.toLowerCase()}
            >
              <ProjectCard project={p} />
            </div>
          ))
        }
      </div>

      <div id="no-results" class="text-center py-16 hidden" aria-live="polite">
        <p class="text-text-secondary text-lg">
          No matching projects. Try another search or clear the filters.
        </p>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/project-filter';
  </script>
</PageLayout>
